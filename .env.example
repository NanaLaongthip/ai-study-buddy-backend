PORT=5000
DATABASE_URL="postgresql://<user>:<password>@localhost:5432/ai_study_buddy?schema=public"
CLIENT_URL="http://localhost:5173"

# LLM Configuration (OpenAI, Local LLM via Ollama/LM Studio, or Groq)
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# Set to true for offline mock generation without calling external LLM
MOCK_AI=false
